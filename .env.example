# Copy to .env and fill in. Never commit .env.

# --- Model provider: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- LangSmith (https://smith.langchain.com -> Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=docs-agent-lab
# EU workspace? uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Optional, same switches chat-langchain uses (see docs/tracing.md)
# Copy 100% of blocked + 1% of allowed questions into the dataset docs-agent-lab-guardrails-samples
# GUARDRAILS_SAMPLE_TO_DATASET=true
# Read the :staging Prompt Hub tags instead of :production
# LANGSMITH_ENV=dev
# Also send traces to more LangSmith endpoints (JSON map of endpoint -> API key)
# LANGSMITH_RUNS_ENDPOINTS=

# --- Local docs MCP server (this repo's server/)
DOCS_MCP_URL=http://localhost:3333/mcp
